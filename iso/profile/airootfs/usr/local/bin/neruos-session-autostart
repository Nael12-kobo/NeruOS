#!/bin/sh
set -u

# Keep per-user logs available for startup diagnostics.
mkdir -p "$HOME/.local/state"

# Show the lightweight NeruOS logo animation first. Run it in the foreground
# so the full-screen desktop cannot cover the splash before it is seen.
/usr/local/bin/neruos-shell --boot-splash >>"$HOME/.local/state/neruos-boot.log" 2>&1
splash_status=$?

if [ "$splash_status" -ne 0 ]; then
    printf 'NeruOS Boot Animation exited with status %s\n' "$splash_status" \
        >>"$HOME/.local/state/neruos-boot.log"
fi

# Reveal the desktop after the boot animation completes.
exec /usr/local/bin/neruos-shell >>"$HOME/.local/state/neruos-shell.log" 2>&1
